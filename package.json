  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "export": "expo export --platform all",
    "sync:catalog": "node scripts/sync-market-catalog.cjs",
    "check": "tsc --noEmit && eslint ."
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "glob@13.0.6": "14.0.2",
      "@expo/cli>node-forge": "1.4.3",
      "minimatch@10.2.6": "11.0.1"
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "@react-native-google-signin/google-signin"
        ]
      }
    }
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24.3.0 <25"
  },
  "packageManager": "pnpm@10.32.1"
