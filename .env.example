# Public configuration only. No database, provider private key, or server secret.
EXPO_PUBLIC_API_URL=https://souqhamad.com
# iOS uses native Sign in with Apple; no Google iOS OAuth values are required.
# Apple private keys and APNs credentials belong on the server / CI, never here.
# Optional override of the registered production Android FCM client file.
# GOOGLE_SERVICES_JSON=
# GOOGLE_SERVICES_JSON_BASE64=
# APP_VARIANT=development
